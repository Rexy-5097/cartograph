{
  "name": "cartograph-walkthrough",
  "private": true,
  "description": "A text-and-motion walkthrough of Cartograph, rendered to video with Remotion.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fonts.mjs",
    "audio": "python audio/synth.py",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Walkthrough out/cartograph-walkthrough.mp4 --crf=20 --color-space=bt709",
    "render:commercial": "remotion render src/index.ts Commercial out/cartograph-commercial.mp4 --crf=20 --color-space=bt709 --audio-bitrate=192k",
    "still": "remotion still src/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@remotion/cli": "4.0.542",
    "@remotion/transitions": "4.0.542",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.542"
  }
}
